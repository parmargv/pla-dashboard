# Local (default if unset): SQLite file
# DATABASE_URL=sqlite:///data/pla.db

# Server: PostgreSQL
DATABASE_URL=postgresql+psycopg://pla:change-me@localhost:5432/pla

# Optional: create this administrator on first start (only if no users exist).
# If left empty, the app shows a one-time "First-time setup" screen instead.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Sign users out after this many idle minutes (0 = never)
SESSION_TIMEOUT_MINUTES=30

# Shown in the sidebar, the sign-in screen and the exported Excel title
OFFICE_NAME=PLA Account
